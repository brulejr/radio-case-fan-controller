(text "Radio Case Fan Controller - carrier board rev A" (exclude_from_sim no) (at 127.00 106.68 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "8b78d9be-dcd4-41da-9df6-906e7b1e0353"))
(text "Dev board (ESP32-C6-WROOM-1, 2x15) plugs into J5/J6. Rows 25.4 mm apart." (exclude_from_sim no) (at 127.00 110.49 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "bb542bb4-0844-4045-aedc-e1022322a02e"))
(text "U1 feeds +5V into the dev board 5V pins (= its USB VBUS). ONE POWER SOURCE AT A TIME:" (exclude_from_sim no) (at 127.00 114.30 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "578d0d0a-8236-46d1-ac1f-383777270854"))
(text "   unplug 12V before connecting USB. Flash over OTA once in the box." (exclude_from_sim no) (at 127.00 118.11 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "7f0ff012-dcd0-4e4a-a14c-4f8ca3e8a398"))
(text "R1/R2/R3 pull up to +3V3, never +5V (tach is open-collector onto a 3.3V GPIO)." (exclude_from_sim no) (at 127.00 121.92 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "96d0db14-ca62-473d-b09a-ff919837ec8f"))
(text "C5/C6 shunt PWM crosstalk off the tach lines. R4/C3, R5/C4 soften PWM edges. R6/C7 are 1-Wire filter spares." (exclude_from_sim no) (at 127.00 125.73 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "f28a4859-48e2-4c87-a8d4-357a3d49456a"))
(text "No input protection by design: fed from a battery/bench supply (see docs/wiring.md)." (exclude_from_sim no) (at 127.00 129.54 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "42fcbdeb-f69a-4ebc-8821-ee253cb47310"))
(text "J2/J3 are 5V FANS ONLY - same connector as a 12V motherboard header." (exclude_from_sim no) (at 127.00 133.35 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "52f62e8e-07ac-43c1-91aa-2dab97875be0"))
 (sheet_instances (path "/" (page "1")))
